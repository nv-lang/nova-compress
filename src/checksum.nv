// SPDX-License-Identifier: MIT OR Apache-2.0
// nova-compress/src/checksum.nv — CRC-32 (gzip) + Adler-32 (zlib) facade.
//
// [M-compress-checksum-cleanup] (2026-07-21): собственная реализация здесь
// была дублем `std/checksums/{crc32,adler32}.nv` (уже дедуплицирован на
// стороне std/encoding/compress той же волной). Дубль снесён — facade
// re-export для внешних потребителей модуля `compress` (совместимость по
// имени `import compress.{crc32, adler32, ...}` не меняется).
//
// Спецификации:
//   - CRC-32 IEEE 802.3, poly 0xEDB88320 (reversed 0x04C11DB7) — RFC 1952 (gzip).
//   - Adler-32 mod 65521 — RFC 1950 (zlib) §9.

module compress

export import std.checksums.crc32.{crc32, crc32_init, crc32_update, crc32_finalize}
export import std.checksums.adler32.{adler32, adler32_init, adler32_update, adler32_finalize}


// Тесты (crc32/adler32 test-vectors) — в checksum_test.nv (рядом с модулем).
